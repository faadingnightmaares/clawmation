# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Update-signing keys. The real one lives outside the repo (see docs/RELEASING.md);
# this is here so a stray copy can never be committed.
*.key
!*.key.pub

# Runtime data. A debug build resolves its data root to this folder (see
# src-tauri/src/paths.rs), so every setting saved, macro recorded, template
# captured and snapshot taken during `tauri dev` lands here. It is one
# developer's state, not source; `ensure_dirs()` recreates the folders on
# first run.
/config/
/macros/
/templates/
/snapshots/

# Local browser mockups and visual QA harnesses created during design work.
/.superpowers/
