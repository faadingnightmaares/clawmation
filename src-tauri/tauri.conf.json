{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clawmation",
  "version": "1.1.3",
  "identifier": "com.faadingnightmaares.clawmation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clawmation",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#15120e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/faadingnightmaares/clawmation/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RDVCQzQxRURDNjEzQTYKUldTbUU4YnRRYnpWRjFMOGxqNi9IdzVFeEdSNlVOQ2laOWsrc1paYXBDNmNuSW1MbTI0b2RYa1oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
